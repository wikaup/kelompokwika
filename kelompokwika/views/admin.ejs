<%- include('partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="mb-1"><i class="bi bi-database-fill-gear me-2"></i>Admin Panel</h2>
    <p class="text-muted mb-0">Akses & Monitoring Database</p>
  </div>
  <a href="/siswa/tambah" class="btn btn-success">
    <i class="bi bi-plus-lg me-1"></i> Tambah Data
  </a>
</div>

<!-- Statistik -->
<div class="row g-3 mb-4">
  <div class="col-md-4">
    <div class="card bg-primary text-white h-100">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h6 class="card-subtitle mb-1 opacity-75">Total Siswa</h6>
            <h2 class="mb-0"><%= totalSiswa %></h2>
          </div>
          <i class="bi bi-people fs-1 opacity-50"></i>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card bg-success text-white h-100">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h6 class="card-subtitle mb-1 opacity-75">Tabel Database</h6>
            <h2 class="mb-0"><%= tables.length %></h2>
          </div>
          <i class="bi bi-table fs-1 opacity-50"></i>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card bg-info text-white h-100">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h6 class="card-subtitle mb-1 opacity-75">Kolom Tabel Siswa</h6>
            <h2 class="mb-0"><%= columns.length %></h2>
          </div>
          <i class="bi bi-columns fs-1 opacity-50"></i>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Struktur Database -->
<div class="row g-4 mb-4">
  <div class="col-lg-5">
    <div class="card shadow-sm h-100">
      <div class="card-header bg-dark text-white">
        <i class="bi bi-list-ul me-2"></i>Daftar Tabel di Database
      </div>
      <div class="card-body">
        <ul class="list-group list-group-flush">
          <% tables.forEach(t => { 
            const tableName = Object.values(t)[0];
          %>
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <code><%= tableName %></code>
              <span class="badge bg-primary rounded-pill">tabel</span>
            </li>
          <% }) %>
        </ul>
      </div>
    </div>
  </div>

  <div class="col-lg-7">
    <div class="card shadow-sm h-100">
      <div class="card-header bg-dark text-white">
        <i class="bi bi-layout-three-columns me-2"></i>Struktur Tabel <code>siswa</code>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-sm table-bordered mb-0">
            <thead class="table-light">
              <tr>
                <th>Field</th>
                <th>Type</th>
                <th>Null</th>
                <th>Key</th>
                <th>Default</th>
                <th>Extra</th>
              </tr>
            </thead>
            <tbody>
              <% columns.forEach(col => { %>
                <tr>
                  <td><code><%= col.Field %></code></td>
                  <td><%= col.Type %></td>
                  <td><%= col.Null %></td>
                  <td>
                    <% if (col.Key === 'PRI') { %>
                      <span class="badge bg-warning text-dark">PRIMARY</span>
                    <% } else if (col.Key === 'UNI') { %>
                      <span class="badge bg-info text-dark">UNIQUE</span>
                    <% } else { %>
                      <%= col.Key || '-' %>
                    <% } %>
                  </td>
                  <td><%= col.Default !== null ? col.Default : 'NULL' %></td>
                  <td><small><%= col.Extra || '-' %></small></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Isi Data Lengkap -->
<div class="card shadow-sm">
  <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
    <span><i class="bi bi-table me-2"></i>Isi Tabel <code>siswa</code> (Semua Data)</span>
    <span class="badge bg-light text-primary"><%= totalSiswa %> baris</span>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover table-striped mb-0">
        <thead class="table-secondary">
          <tr>
            <th>ID</th>
            <th>NIS</th>
            <th>Nama</th>
            <th>Kelas</th>
            <th>Jurusan</th>
            <th>Email</th>
            <th>Dibuat</th>
            <th class="text-center">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if (siswa.length === 0) { %>
            <tr>
              <td colspan="8" class="text-center py-4 text-muted">
                Tabel masih kosong.
              </td>
            </tr>
          <% } else { %>
            <% siswa.forEach(s => { %>
              <tr>
                <td><%= s.id %></td>
                <td><code><%= s.nis %></code></td>
                <td class="fw-semibold"><%= s.nama %></td>
                <td><span class="badge bg-info text-dark"><%= s.kelas %></span></td>
                <td><%= s.jurusan || '-' %></td>
                <td><small><%= s.email || '-' %></small></td>
                <td><small><%= s.created_at ? new Date(s.created_at).toLocaleString('id-ID') : '-' %></small></td>
                <td class="text-center">
                  <a href="/siswa/edit/<%= s.id %>" class="btn btn-sm btn-outline-warning" title="Edit">
                    <i class="bi bi-pencil"></i>
                  </a>
                  <form action="/siswa/hapus/<%= s.id %>" method="POST" class="d-inline"
                        onsubmit="return confirm('Yakin hapus <%= s.nama %>?')">
                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Hapus">
                      <i class="bi bi-trash"></i>
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="alert alert-secondary mt-4 small">
  <i class="bi bi-lightbulb me-1"></i>
  <strong>Catatan untuk Siswa:</strong> Halaman Admin ini menampilkan struktur database secara real-time 
  menggunakan query <code>SHOW TABLES</code> dan <code>SHOW COLUMNS FROM siswa</code>. 
  Ini berguna untuk memahami bagaimana aplikasi berinteraksi dengan database.
</div>

<%- include('partials/footer') %>
